{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contract",
  "type": "object",
  "properties": {
    "conversation": {
      "$ref": "#/$defs/Conversation"
    },
    "conversation_draft": {
      "$ref": "#/$defs/ConversationDraft"
    },
    "failure": {
      "$ref": "#/$defs/Failure"
    },
    "memory_source": {
      "$ref": "#/$defs/MemorySource"
    },
    "memory_space": {
      "$ref": "#/$defs/MemorySpace"
    },
    "message": {
      "$ref": "#/$defs/Message"
    },
    "prompt": {
      "$ref": "#/$defs/Prompt"
    },
    "provider": {
      "$ref": "#/$defs/Provider"
    },
    "provider_draft": {
      "$ref": "#/$defs/ProviderDraft"
    },
    "settings": {
      "$ref": "#/$defs/Settings"
    },
    "thread": {
      "$ref": "#/$defs/Thread"
    }
  },
  "required": [
    "provider",
    "provider_draft",
    "conversation",
    "conversation_draft",
    "message",
    "thread",
    "prompt",
    "settings",
    "failure",
    "memory_space",
    "memory_source"
  ],
  "$defs": {
    "Conversation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "providerId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "spaceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "updatedAt"
      ]
    },
    "ConversationDraft": {
      "type": "object",
      "properties": {
        "providerId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "spaceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "title"
      ]
    },
    "Failure": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        }
      },
      "required": [
        "error"
      ]
    },
    "MemoryCitation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ]
    },
    "MemorySource": {
      "type": "object",
      "properties": {
        "createdBy": {
          "type": "string"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "secrets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SecretReference"
          }
        },
        "spaceId": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "spaceId",
        "text",
        "status",
        "secrets",
        "createdBy",
        "updatedAt"
      ]
    },
    "MemorySpace": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "modelBinding": {
          "type": [
            "string",
            "null"
          ]
        },
        "personal": {
          "type": "boolean"
        },
        "role": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "personal",
        "role"
      ]
    },
    "Message": {
      "type": "object",
      "properties": {
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemoryCitation"
          }
        },
        "content": {
          "type": "string"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "memoryStatus": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": "string"
        },
        "sourceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        }
      },
      "required": [
        "id",
        "role",
        "content",
        "status",
        "citations"
      ]
    },
    "Prompt": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "content"
      ]
    },
    "Provider": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "hasSecret": {
          "type": "boolean"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "label": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "endpoint",
        "model",
        "hasSecret"
      ]
    },
    "ProviderDraft": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "secret": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "endpoint",
        "model"
      ]
    },
    "SecretReference": {
      "type": "object",
      "properties": {
        "canManage": {
          "type": "boolean"
        },
        "canReveal": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "sourceId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "sourceId",
        "canReveal",
        "canManage"
      ]
    },
    "Settings": {
      "type": "object",
      "properties": {
        "allowedEndpoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxPromptChars": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "memoryAvailable": {
          "type": "boolean"
        },
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Provider"
          }
        }
      },
      "required": [
        "allowedEndpoints",
        "providers",
        "maxPromptChars",
        "memoryAvailable"
      ]
    },
    "Thread": {
      "type": "object",
      "properties": {
        "conversation": {
          "$ref": "#/$defs/Conversation"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Message"
          }
        }
      },
      "required": [
        "conversation",
        "messages"
      ]
    }
  }
}
